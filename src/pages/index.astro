---
/**
 * The talk.
 *
 * A wrapper, as on bryanfawcett.com: the slides are records in
 * `src/data/slides.ts` and the shapes are in `Slide.astro`, so there is nothing
 * to write here but the loop.
 */
import Deck from '../layouts/Deck.astro';
import Slide from '../components/Slide.astro';
import { SLIDES } from '../data/slides.js';
---

<Deck
  title="Origins with a Perspective on Human Potential — Bryan Fawcett"
  description="A talk on equity and the assumptions we make in learning: what growing up in Zimbabwe taught me about measuring capability instead of credentials."
>
  {SLIDES.map((slide, i) => <Slide slide={slide} index={i} total={SLIDES.length} />)}
</Deck>
