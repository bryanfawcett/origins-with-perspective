    <script>
        // Loading Screen Management
        const MINIMUM_DISPLAY_TIME = 1000;  // show the loading screen for at least this long
        const MAXIMUM_DISPLAY_TIME = 4000;  // never trap the reader behind it

        const dismissLoadingScreen = (() => {
            let dismissed = false;

            return () => {
                if (dismissed) return;
                dismissed = true;

                const loadingScreen = document.getElementById('loadingScreen');
                if (!loadingScreen) return;

                loadingScreen.classList.add('fade-out');
                setTimeout(() => {
                    loadingScreen.style.display = 'none';
                }, 500);
            };
        })();

        // Normal path: everything has loaded.
        window.addEventListener('load', () => {
            setTimeout(dismissLoadingScreen, MINIMUM_DISPLAY_TIME);
        });

        // Fallback: a slow or unreachable image must not hold the page hostage,
        // because `load` only fires once every subresource has settled.
        setTimeout(dismissLoadingScreen, MAXIMUM_DISPLAY_TIME);

        // Optimized Intersection Observer for scroll animations
        let sectionObserver, contentObserver;

        // Build one navigation dot per section so the two can never drift apart
        const buildScrollDots = () => {
            const indicator = document.getElementById('scrollIndicator');
            const sections = document.querySelectorAll('.section');
            if (!indicator) return;

            sections.forEach((section, index) => {
                const dot = document.createElement('button');
                dot.type = 'button';
                dot.className = index === 0 ? 'scroll-dot active' : 'scroll-dot';
                dot.dataset.section = String(index);

                const heading = section.querySelector('.section-title, .hero-title');
                const label = heading ? heading.textContent.trim() : `Section ${index + 1}`;
                dot.setAttribute('aria-label', `Go to ${label}`);

                indicator.appendChild(dot);
            });
        };

        const initializeObservers = () => {
            const sections = document.querySelectorAll('.section');
            const scrollDots = document.querySelectorAll('.scroll-dot');
            const contentBoxes = document.querySelectorAll('.content-box');

            // threshold 0: a section taller than the viewport can never reach a
            // meaningful intersection ratio, so tall sections would otherwise
            // stay at opacity 0 on small screens and never reveal.
            const observerOptions = {
                root: null,
                rootMargin: '-10% 0px -10% 0px',
                threshold: 0
            };

            // Single observer for sections with scroll indicator update
            sectionObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        
                        // Update scroll indicator efficiently
                        const sectionIndex = Array.from(sections).indexOf(entry.target);
                        scrollDots.forEach((dot, index) => {
                            dot.classList.toggle('active', index === sectionIndex);
                        });
                    }
                });
            }, observerOptions);

            // Separate observer for content boxes
            contentObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, observerOptions);

            // Observe elements
            sections.forEach(section => sectionObserver.observe(section));
            contentBoxes.forEach(box => contentObserver.observe(box));
        };

        // Optimized smooth scroll for navigation dots
        const initializeNavigation = () => {
            const sections = document.querySelectorAll('.section');
            const scrollDots = document.querySelectorAll('.scroll-dot');

            scrollDots.forEach((dot, index) => {
                dot.addEventListener('click', () => {
                    const targetSection = sections[index];
                    if (targetSection) {
                        targetSection.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
        };

        // Daniel Pink popup functions (consolidated)
        const popupFunctions = {
            open() {
                const popup = document.getElementById('danielPinkPopup');
                popup.classList.add('show');
                document.body.style.overflow = 'hidden';
            },
            
            close() {
                const popup = document.getElementById('danielPinkPopup');
                popup.classList.remove('show');
                document.body.style.overflow = 'auto';
            }
        };

        // Make popup functions global
        window.openDanielPinkPopup = popupFunctions.open;
        window.closeDanielPinkPopup = popupFunctions.close;

        // Event listeners for popup
        const initializePopup = () => {
            const popup = document.getElementById('danielPinkPopup');
            
            // Close when clicking outside
            popup.addEventListener('click', function(e) {
                if (e.target === this) {
                    popupFunctions.close();
                }
            });

            // Close with Escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    popupFunctions.close();
                }
            });
        };

        // Image loading optimization
        const optimizeImages = () => {
            const images = document.querySelectorAll('img');
            images.forEach(img => {
                // Add loading="lazy" if not already present
                if (!img.hasAttribute('loading')) {
                    img.setAttribute('loading', 'lazy');
                }
                
                // Error handling
                img.addEventListener('error', function() {
                    this.style.display = 'none';
                    const overlay = this.nextElementSibling;
                    if (overlay && overlay.classList.contains('image-overlay')) {
                        overlay.style.background = '#f8f9fa';
                        overlay.style.color = '#666';
                        overlay.innerHTML = '📷 Image unavailable';
                    }
                });
            });
        };

        // Initialize everything when DOM is ready
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize all components
            buildScrollDots();
            initializeObservers();
            initializeNavigation();
            initializePopup();
            optimizeImages();
            
            // Make first section visible immediately
            const firstSection = document.getElementById('section-0');
            if (firstSection) {
                firstSection.classList.add('visible');
            }
        });

        // Cleanup observers on page unload
        window.addEventListener('beforeunload', () => {
            if (sectionObserver) sectionObserver.disconnect();
            if (contentObserver) contentObserver.disconnect();
        });
    </script>
